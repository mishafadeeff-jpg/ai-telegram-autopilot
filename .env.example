# Telegram Bot Configuration
# Get token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Channel Username or ID (e.g. @AIPulseDaily or -1001234567890)
# Make sure your bot is added as an Administrator to this channel!
TELEGRAM_CHANNEL_ID=@AIPulseDaily

# Channel Branding
CHANNEL_NAME=⚡ AI Pulse Daily
CHANNEL_LINK=https://t.me/AIPulseDaily

# Optional: Gemini API key for advanced rewrites (leave blank for built-in smart engine)
GEMINI_API_KEY=

# Schedule (Hours between posts)
POSTING_INTERVAL_HOURS=4
MAX_POSTS_PER_RUN=1
